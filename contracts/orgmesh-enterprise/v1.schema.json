          "const": "usage.begin",
          "title": "Operation",
          "type": "string"
        },
        "lease": {
          "$ref": "#/$defs/SnapshotLease"
        }
      },
      "required": [
        "operation",
        "lease"
      ],
      "title": "UsageBeginResponse",
      "type": "object"
    },
    "UsageCommitRequest": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "usage.commit",
          "default": "usage.commit",
          "title": "Operation",
          "type": "string"
        },
        "lease": {
          "$ref": "#/$defs/SnapshotLease"
        },
        "manifest": {
          "$ref": "#/$defs/SnapshotManifest"
        }
      },
      "required": [
        "operation",
        "lease",
        "manifest"
      ],
      "title": "UsageCommitRequest",
      "type": "object"
    },
    "UsageCommitResponse": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "usage.commit",
          "title": "Operation",
          "type": "string"
        },
        "published": {
          "$ref": "#/$defs/PublishedSnapshot"
        }
      },
      "required": [
        "operation",
        "published"
      ],
      "title": "UsageCommitResponse",
      "type": "object"
    },
    "UsageGroup": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "category": {
          "enum": [
            "USER",
            "SYSTEM_ATTRIBUTED",
            "SYSTEM_UNATTRIBUTED"
          ],
          "title": "Category",
          "type": "string"
        },
        "incognito": {
          "title": "Incognito",
          "type": "boolean"
        },
        "totals": {
          "$ref": "#/$defs/UsageTotals"
        }
      },
      "required": [
        "value",
        "category",
        "incognito",
        "totals"
      ],
      "title": "UsageGroup",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "enum": [
                  "SYSTEM_ATTRIBUTED",
                  "SYSTEM_UNATTRIBUTED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "incognito": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "UsageStageRequest": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "usage.stage",
          "default": "usage.stage",
          "title": "Operation",
          "type": "string"
        },
        "lease": {
          "$ref": "#/$defs/SnapshotLease"
        },
        "batch": {
          "$ref": "#/$defs/SnapshotBatch"
        }
      },
      "required": [
        "operation",
        "lease",
        "batch"
      ],
      "title": "UsageStageRequest",
      "type": "object"
    },
