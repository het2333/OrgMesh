          "const": "usage.stage",
          "title": "Operation",
          "type": "string"
        },
        "ack": {
          "$ref": "#/$defs/StageAck"
        }
      },
      "required": [
        "operation",
        "ack"
      ],
      "title": "UsageStageResponse",
      "type": "object"
    },
    "UsageTotals": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "pattern": "^(0|[1-9][0-9]{0,31})$",
          "title": "Input Tokens",
          "type": "string"
        },
        "output_tokens": {
          "pattern": "^(0|[1-9][0-9]{0,31})$",
          "title": "Output Tokens",
          "type": "string"
        },
        "total_tokens": {
          "pattern": "^(0|[1-9][0-9]{0,31})$",
          "title": "Total Tokens",
          "type": "string"
        },
        "cache_read_tokens": {
          "pattern": "^(0|[1-9][0-9]{0,31})$",
          "title": "Cache Read Tokens",
          "type": "string"
        },
        "cache_creation_tokens": {
          "pattern": "^(0|[1-9][0-9]{0,31})$",
          "title": "Cache Creation Tokens",
          "type": "string"
        },
        "cost_cents": {
          "pattern": "^(0|[1-9][0-9]{0,31})\\.[0-9]{6}$",
          "title": "Cost Cents",
          "type": "string"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "cache_read_tokens",
        "cache_creation_tokens",
        "cost_cents"
      ],
      "title": "UsageTotals",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/EnterpriseRequestEnvelope"
    },
    {
      "discriminator": {
        "mapping": {
          "audit.list": "#/$defs/AuditListResponse",
          "branding.patch": "#/$defs/BrandingPatchResponse",
          "branding.read": "#/$defs/BrandingReadResponse",
          "usage.begin": "#/$defs/UsageBeginResponse",
          "usage.commit": "#/$defs/UsageCommitResponse",
          "usage.stage": "#/$defs/UsageStageResponse",
          "usage.summary": "#/$defs/UsageSummaryResponse"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BrandingReadResponse"
        },
        {
          "$ref": "#/$defs/BrandingPatchResponse"
        },
        {
          "$ref": "#/$defs/AuditListResponse"
        },
        {
          "$ref": "#/$defs/UsageSummaryResponse"
        },
        {
          "$ref": "#/$defs/UsageBeginResponse"
        },
        {
          "$ref": "#/$defs/UsageStageResponse"
        },
        {
          "$ref": "#/$defs/UsageCommitResponse"
        }
      ]
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgmesh.local/contracts/orgmesh-enterprise/v1.schema.json",
  "title": "OrgMesh enterprise private transport v1",
  "description": "Private v1 calls are limited to 1048576 UTF-8 bytes. Usage uses UTC daily buckets, exact fixed-six-place USD-cents strings, and a producer-only fenced snapshot protocol. See usage-protocol.md for byte encoding, activation, limits, coverage, and runtime checks."
}
