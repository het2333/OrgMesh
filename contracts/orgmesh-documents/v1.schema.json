{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orgmesh:documents:v1",
  "$defs": {
    "SelectionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "content_hash",
        "schema_version",
        "from",
        "to",
        "selected_text_hash"
      ],
      "properties": {
        "version_id": {
          "type": "string",
          "format": "uuid"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_version": {
          "type": "string"
        },
        "from": {
          "type": "integer",
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "minimum": 1
        },
        "selected_text_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "DocumentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "version_id",
        "content_hash",
        "title",
        "project_id"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "version_id": {
          "type": "string",
          "format": "uuid"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "title": {
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "VersionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "version_id",
        "content_hash",
        "title",
        "project_id",
        "parent_version_id",
        "operation"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "version_id": {
          "type": "string",
          "format": "uuid"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "title": {
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_version_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "enum": [
            "import",
            "manual",
            "ai_accept",
            "restore"
          ]
        }
      }
    },
    "RunState": {
      "enum": [
        "queued",
        "running",
        "completed",
        "cancelled",
        "failed"
      ]
    },
    "ProposalState": {
      "enum": [
        "ready",
        "accepted",
        "rejected",
        "stale",
        "expired"
      ]
    },
    "RunRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "chat_session_id"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "chat_session_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "CandidateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "selection_ref",
        "replacement_text"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "selection_ref": {
          "$ref": "#/$defs/SelectionRef"
        },
        "replacement_text": {
          "type": "string"
        }
      }
    },
    "CandidateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_hash",
        "diff",
        "unchanged_parts_ok"
      ],
      "properties": {
        "candidate_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "diff": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "text"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "equal",
                  "insert",
                  "delete"
                ]
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "unchanged_parts_ok": {
          "type": "boolean"
        }
      }
    },
    "RunEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "sequence",
        "event_id",
        "type",
        "payload"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "enum": [
            "message_delta",
            "tool_started",
            "tool_finished",
            "proposal_ready",
            "run_completed",
            "run_cancelled",
            "run_failed"
          ]
        },
        "payload": {
          "type": "object"
        }
      }
    }
  }
}
